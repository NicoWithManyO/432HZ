# Gabarit de configuration — copier en `.env` et renseigner les valeurs.
# Le `.env` réel n'est JAMAIS commité (cf .gitignore). Secrets lus via python-decouple.

# Clé secrète Django (obligatoire). Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Hôtes autorisés, séparés par des virgules.
# Dev : 127.0.0.1,localhost  —  Prod : le vrai domaine (ex. 432hz.fr,www.432hz.fr)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Chemin de la base SQLite (optionnel ; défaut = db.sqlite3 à la racine).
# DJANGO_DB_PATH=/var/lib/432hz/db.sqlite3

# --- Sécurité (prod) ---

# Origines de confiance pour le CSRF (schéma inclus), séparées par des virgules.
# Indispensable derrière HTTPS/proxy (ex. https://432hz.fr,https://www.432hz.fr).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Durée HSTS en secondes (optionnel ; défaut = 31536000 = 1 an). 0 pour désactiver.
# DJANGO_HSTS_SECONDS=31536000

# Passe la CSP en report-only (optionnel ; défaut = False) : utile pour diagnostiquer
# une violation sans rien bloquer. Repasser à False une fois la politique validée.
# DJANGO_CSP_REPORT_ONLY=False
