{
  "name": "432hz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pipeline front du site 432 Hz : Tailwind (charte affiche) + fonts self-hosted. Build léger, sans framework.",
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "css": "tailwindcss -i theme/globals.css -o static/css/app.css --minify",
    "css:watch": "tailwindcss -i theme/globals.css -o static/css/app.css --watch",
    "build": "npm run fonts && npm run css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.5",
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/space-mono": "^5.2.5"
  }
}
